# Copy this file to .env and fill in your values.
# Never commit .env to the repository.
#
# Portainer: enter the same names and values under the stack's
# "Environment variables" instead of using a .env file.
# If a value contains a dollar sign, write it as $$ (Compose treats $ specially).

# Token from @BotFather (required)
BOT_TOKEN=

# Your Telegram user id (required). The owner cannot be demoted by any command.
OWNER_ID=

# PostgreSQL connection string (required).
#   Postgres container on the shared "postgres-internal" network: host "postgresql"
#   Bot started directly (no Docker):                             host "localhost"
# If the password contains special characters, URL-encode them.
DATABASE_URL=postgresql://argo:change-me@postgresql:5432/argo

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Developer log chat: bot start/stop messages and error reports (traceback files).
# Leave empty to send them to the owner in private.
DEV_LOG_CHAT=
# Topic id, only if DEV_LOG_CHAT is a group with topics enabled.
DEV_LOG_THREAD_ID=

# Public role log chat: promotions and demotions (#SUDO, #UNSUDO, ...).
# Meant for a group everyone can read. Leave empty to use the developer log.
# The bot must be a member of this chat and allowed to post.
ROLE_LOG_CHAT=
# Topic id, only if ROLE_LOG_CHAT is a group with topics enabled.
ROLE_LOG_THREAD_ID=

# Characters that can start a command. Default: /!
# In groups, "!" commands only reach the bot if it is an admin or has privacy
# mode disabled (BotFather: /setprivacy).
COMMAND_PREFIXES=/!

# Repository link shown as a button in /start (private chat).
# Leave empty to use the default (https://github.com/R0Xofficial/ArgoRobot).
GITHUB_URL=
