# Copy this file to .env and fill in your values.
# Never commit .env to the repository.
#
# Portainer: enter the same names and values under the stack's
# "Environment variables" instead of using a .env file.
# If a value contains a dollar sign, write it as $$ (Compose treats $ specially).

# Token from @BotFather (required)
BOT_TOKEN=

# Your Telegram user id (required). The owner cannot be demoted by any command.
OWNER_ID=

# PostgreSQL connection string (required).
#   Postgres container on the shared "postgres-internal" network: host "postgresql"
#   Bot started directly (no Docker):                             host "localhost"
# If the password contains special characters, URL-encode them.
DATABASE_URL=postgresql://argo:change-me@postgresql:5432/argo

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Developer log chat: bot start/stop messages and error reports (traceback files).
# Leave empty to send them to the owner in private.
DEV_LOG_CHAT=
# Topic id, only if DEV_LOG_CHAT is a group with topics enabled.
DEV_LOG_THREAD_ID=

# How often (in hours) the bot sends its log to the developer log chat as a .txt file:
# a time, a level and what happened on every line, plus the period it covers.
# Default: 6. Use 0 to turn the reports off. A last one is sent when the bot stops.
LOG_REPORT_HOURS=6

# User log chat: promotions and demotions (#SUDO, #UNSUDO, ...) and other public
# information. Meant for a group everyone can read. Leave empty to use the developer log.
# The bot must be a member of this chat and allowed to post.
LOG_CHAT_ID=
# Topic id, only if LOG_CHAT_ID is a group with topics enabled.
LOG_THREAD_ID=

# How often (in hours) the bot checks which stored chats it has been removed from.
# Default: 24. Use 0 to turn the scheduled check off (/cleanchats still works).
CHAT_CLEANUP_HOURS=24

# The support chat (for example @MySupport): named at the bottom of /help, where people
# report bugs, and in the alert of a global ban, where they can appeal it. Empty shows nothing.
SUPPORT_CHAT_USERNAME=@ArgoRobotSupport

# Characters that can start a command. Default: /!
# In groups, "!" commands only reach the bot if it is an admin or has privacy
# mode disabled (BotFather: /setprivacy).
COMMAND_PREFIXES=/!

# Repository link shown as a button in /start (private chat).
# Leave empty to use the default (https://github.com/R0Xofficial/ArgoRobot).
GITHUB_URL=
