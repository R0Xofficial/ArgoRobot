# Argo (Go): environment variables. Fill in the three required ones, the rest is optional.
# An empty value means the default. No quotes.

# --- REQUIRED ---
BOT_TOKEN=
OWNER_ID=
DATABASE_URL=postgresql://user:password@postgres:5432/argo

# --- Developer logs (optional) ---
# Developer log chat (start/stop, errors, log reports). Empty = your private chat.
DEV_LOG_CHAT=
# Topic (thread) id for DEV_LOG_CHAT, if it is a forum.
DEV_LOG_THREAD_ID=
# User log chat (role changes, global bans). Empty = the developer log.
LOG_CHAT_ID=
LOG_THREAD_ID=
# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
# How often (in hours) the log is sent to the developer log as a .txt file. 0 = off.
LOG_REPORT_HOURS=6

# --- Bot behaviour (optional) ---
# How often (in hours) the stored chats are checked against Telegram. 0 = off.
CHAT_CLEANUP_HOURS=24
# Characters that start a command.
COMMAND_PREFIXES=/!
# Appeal chat for banned people (with @) and the link shown by /start.
SUPPORT_CHAT_USERNAME=@ArgoRobotSupport
GITHUB_URL=https://github.com/R0Xofficial/ArgoRobot

# --- MTProto for /zombies (optional, from my.telegram.org) ---
API_ID=
API_HASH=
