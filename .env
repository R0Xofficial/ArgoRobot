# Copy this file to .env and fill in your values.
# Never commit .env to the repository.

# Token from @BotFather (required)
BOT_TOKEN=

# Your Telegram user id (required). The owner cannot be demoted by any command.
OWNER_ID=

# PostgreSQL connection string (required).
# Used when running the bot directly on your machine. Inside Docker Compose the
# host is replaced with the "postgres" service automatically.
# If the password contains special characters, URL-encode them.
DATABASE_URL=postgresql://argo:change-me@localhost:5432/argo

# Password for the PostgreSQL container (used by docker-compose.yml).
# Must match the password inside DATABASE_URL above.
POSTGRES_PASSWORD=change-me

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Chat that receives service messages such as "Bot started".
# Leave empty to send them to the owner in private.
LOG_CHAT_ID=
# Topic id, only if LOG_CHAT_ID is a group with topics enabled.
LOG_THREAD_ID=
