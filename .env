# Copy this file to .env and fill in your values.
# Never commit .env to the repository.

# Token from @BotFather (required)
BOT_TOKEN=

# Your Telegram user id (required). The owner cannot be demoted by any command.
OWNER_ID=

# PostgreSQL connection string (required).
#   Postgres on the same VPS, bot in Docker:  host.docker.internal
#   Postgres on another server:               its address or hostname
#   Bot started directly (no Docker):         localhost
# If the password contains special characters, URL-encode them.
DATABASE_URL=postgresql://argo:change-me@host.docker.internal:5432/argo

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Chat that receives service messages such as "Bot started".
# Leave empty to send them to the owner in private.
LOG_CHAT_ID=
# Topic id, only if LOG_CHAT_ID is a group with topics enabled.
LOG_THREAD_ID=
