  "nightmode.about": "\nNightmode closes the chat at the hour you choose and opens it again in the morning. While it is closed, nobody but the admins can write; the chat's permissions from before are saved and put back exactly as they were.\n\nBy default the night lasts from 23:00 to 07:00 in UTC. Set your own hours with /nighthours (a night may pass midnight) and your time zone with /nighttz, for example /nighttz Europe/Warsaw or /nighttz UTC+1.\n\nI announce both the closing and the opening. Nightmode is off until a chat admin turns it on, and I need the right to restrict members.\n",
  "nightmode.closed": "closed",
  "nightmode.help.the_time_zone_of_those": "The time zone of those hours: a name like Europe/Warsaw, or an offset like UTC+1. Default: UTC.",
  "nightmode.help.turn_nightmode_on_or_off": "Turn nightmode on or off, or show its settings.",
  "nightmode.help.when_the_night_starts_and": "When the night starts and ends, like /nighthours 23:00 07:00. Default: 23:00 to 07:00.",
  "nightmode.i_can_t_change_the_permissions": "I can't change the permissions of this chat: {getattr}",
  "nightmode.night_mode_is_on_but_i": "Night mode is on, but I can't change the permissions of this chat. I need the right to restrict members.",
  "nightmode.night_mode_is_on_the_chat": "<b>Night mode is on.</b> The chat is closed until {clock_text} ({zone}). Good night!",
  "nightmode.night_mode_is_over_the_chat": "<b>Night mode is over.</b> The chat is open again. Good morning!",
  "nightmode.nightmode_enabled_night_to_time_zone": "<b>Nightmode</b>\n• <b>Enabled:</b> <code>{opt}</code>\n• <b>Night:</b> <code>{clock_text}</code> to <code>{clock_text2}</code>\n• <b>Time zone:</b> <code>{zone}</code> (now <code>{now:%H:%M}</code> there)\n• <b>Chat right now:</b> <code>{opt2}</code>",
  "nightmode.open": "open",
  "nightmode.the_hours_of_the_night_are": "The hours of the night are now in <b>{name}</b>.",
  "nightmode.the_night_has_begun_i_close": "\nThe night has begun; I close the chat within half a minute.",
  "nightmode.the_night_now_lasts_from_to": "The night now lasts from <b>{clock_text}</b> to <b>{clock_text2}</b> ({zone}).",
  "nightmode.use_nighthours_lt_from_gt_lt": "Use /nighthours &lt;from&gt; &lt;to&gt;, two different hours like <code>23:00 07:00</code> (24-hour clock). The night may pass midnight.",
  "nightmode.use_nightmode_on_or_nightmode_off": "Use /nightmode on or /nightmode off.",
  "nightmode.use_nighttz_lt_zone_gt_a": "Use /nighttz &lt;zone&gt;: a name like <code>Europe/Warsaw</code> (it follows summer time), or an offset like <code>UTC+1</code> or <code>-5:30</code>.",
  "notes.about": "\nSave a message under a name, and anyone in the chat can ask for it later with /get name or by writing #name. Good for rules, links and answers to questions that keep coming back.\n\nA note can be text, or any media: a photo, video, GIF, sticker, document, audio or voice message, with text as its caption. Write the text after the name, or reply to a message to save that message as it is. The commands that change notes are for chat admins with the right to change chat info.\n\nNames are one word, and case does not matter. Under the text, formatting, fillings, buttons and random variants work as described below.\n",
  "notes.cancelled_the_notes_are_unchanged": "Cancelled. The notes are unchanged.",
  "notes.done_notes_deleted": "Done. <b>{removed}</b> notes deleted.",
  "notes.get_one_with_get_lt_name": "Get one with /get &lt;name&gt; or #name.",
  "notes.help.delete_every_note_in_this": "Delete every note in this chat. Asks for confirmation.",
  "notes.help.get_a_saved_note_writing": "Get a saved note. Writing #name does the same.",
  "notes.help.list_every_note_in_this": "List every note in this chat.",
  "notes.help.remove_a_note": "Remove a note.",
  "notes.help.save_a_note_reply_to": "Save a note. Reply to a message instead of writing text to save that message, media included. Saving under an existing name replaces the note.",
  "notes.note": "note {name!r}",
  "notes.note.put_these_anywhere_in_the": "\n        Put these anywhere in the text; they are removed and change how the note is sent:\n        {preview} - show link previews.\n        {protect} - forbid forwarding and saving.\n        {nonotif} - send silently.\n        {mediaspoiler} - hide a photo, GIF or video behind a spoiler.\n        ",
  "notes.note.replaced_by_facts_about_whoever": "\n        Replaced by facts about whoever asks for the note:\n        {first} {last} {fullname} {username} {mention} {id} {chatname} {count}\n        {username} falls back to a mention for people without one. {count} is the number of members.\n        ",
  "notes.note.save_rules_be_kind_full": "\n        /save rules <b>Be kind, {first}.</b> [Full rules](buttonurl://example.com/rules)\n        /save logo - reply to a photo to save the photo.\n        /save faq - reply to a document to save the file.\n        /get rules\n        #rules\n        ",
  "notes.note.text_buttonurl_example_com_a": "\n        [Text](buttonurl://example.com) - a button under the note, on its own row.\n        [Text](buttonurl://example.com:same) - a button on the row of the previous one.\n        ",
